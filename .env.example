# Copiá este archivo como .env y completá los valores reales.
# El .env NUNCA se sube a git (está en .gitignore).

# Puerto del servidor
PORT=3000

# Clave para firmar los tokens JWT.
# Generá una larga y aleatoria, por ejemplo con:  openssl rand -hex 32
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# Origen permitido para CORS (la URL del frontend).
# En desarrollo: http://localhost:5173
# En produccion: https://tudominio.com
CORS_ORIGIN=http://localhost:5173

# Conexion a PostgreSQL.
# En produccion llega en una sola cadena (Neon, Render y similares) y las
# variables DB_* de abajo quedan sin usar:
#   DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_db
DB_USER=postgres
DB_PASSWORD=tu_password_aca
